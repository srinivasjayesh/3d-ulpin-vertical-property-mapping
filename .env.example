# Safe defaults for the file-backed research prototype.
DATA_BACKEND=file
DATA_PROFILE=hyderabad

# Optional PostGIS connection. Keep real credentials in a secret manager.
# DATABASE_URL=postgresql://ulpin_app:replace-me@localhost:5432/ulpin
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ulpin
DB_USER=ulpin_app
DB_PASSWORD=replace-me

# Optional DEM download used only by pipeline/10_add_ground_elevation.py.
OPENTOPOGRAPHY_API_KEY=replace-me
